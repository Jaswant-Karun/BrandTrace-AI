# ==============================================================================
# BRANDTRACE AI — Enterprise Deployment Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
DEBUG=false

# ==============================================================================
# 1. DATABASE: MONGODB ATLAS (PRIMARY APPLICATION DATABASE)
# ==============================================================================
# The ONLY primary persistent database for BrandTrace AI.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://brandtrace_admin:ENTER_SECURE_PASSWORD@cluster0.mongodb.net/brandtrace?retryWrites=true&w=majority
MONGODB_DB_NAME=brandtrace

# Atlas Vector Search Configuration
ATLAS_VECTOR_INDEX_NAME=vector_index
ATLAS_VECTOR_DIMENSIONS=768
ATLAS_VECTOR_SIMILARITY=cosine

# ==============================================================================
# 2. SECURITY & JWT AUTHENTICATION
# ==============================================================================
JWT_SECRET_KEY=enter-secure-random-256-bit-key-for-production-signing
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ==============================================================================
# 3. AI REASONING & SEMANTIC RETRIEVAL (GOOGLE GEMINI API)
# ==============================================================================
# Used for structured semantic reasoning and text-embedding-004 vector embeddings
# When absent, system falls back gracefully to deterministic semantic engine
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ==============================================================================
# 4. CLOUD OBJECT STORAGE ABSTRACTION
# ==============================================================================
STORAGE_BACKEND=CLOUD_OBJECT_STORAGE_OR_LOCAL
STORAGE_LOCAL_DIR=./storage/assets
S3_BUCKET_NAME=brandtrace-multimodal-vault
S3_REGION=us-east-1

# ==============================================================================
# 5. FRONTEND & CORS DEPLOYMENT SETTINGS
# ==============================================================================
VITE_API_BASE_URL=https://brandtrace-backend.onrender.com
ALLOWED_ORIGINS=https://brandtrace-ai.vercel.app,http://localhost:5173,http://localhost:3000
