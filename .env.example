# ==============================================================================
# BRANDTRACE AI — Enterprise Deployment & Local Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# MongoDB Database Connection
# Local MongoDB: mongodb://localhost:27017
# Docker Compose: mongodb://mongodb:27017
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=brandtrace

# AI Provider Configuration (Optional — falls back to built-in deterministic neural engine)
# Supported: gemini, openai, anthropic, mock
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# BrandTrace Engine Configuration
LOG_LEVEL=INFO
ENABLE_CASCADING_BLAST_RADIUS=true

# Frontend Configuration
VITE_API_URL=http://localhost:8000
