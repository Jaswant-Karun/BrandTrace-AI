# ==============================================================================
# BRANDTRACE AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure as needed.
# BRANDTRACE AI includes a deterministic local reasoning engine, so it runs
# reliably even without active external API keys.

# Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# AI Provider Configuration (Optional - falls back to deterministic neural engine)
# Supported: gemini, openai, anthropic, mock
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# BrandTrace Engine Configuration
LOG_LEVEL=INFO
GRAPH_STORAGE_PATH=./data/brand_knowledge_graph.json
AUDIT_LEDGER_PATH=./data/release_ledger.json
ENABLE_CASCADING_BLAST_RADIUS=true

# Frontend Configuration
VITE_API_URL=http://localhost:8000
